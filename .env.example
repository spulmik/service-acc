# ===== Параметры сервера =====
PORT=3000
# Папка со собранным фронтендом (по умолчанию ./frontend/dist)
# ASSETS_DIR=/var/www/service-acc/frontend/dist
# Публичный адрес за туннелем (serveo/ngrok/cloudflared). Укажите СВОЙ URL —
# тогда HTTPS/CSRF/Secure-cookie будут считаться по нему, а не по заголовкам.
# PUBLIC_ORIGIN=https://energyb24.serveo.net

# ===== Хранилище (замена Cloudflare KV) =====
# По умолчанию — файловое хранилище, Redis НЕ нужен (подходит для
# виртуального хостинга). Папка данных (по умолчанию ./.data):
# DATA_DIR=./.data
#
# Redis используйте только если он есть (например, на VPS) — тогда
# раскомментируйте строку ниже, и приложение возьмёт Redis вместо файлов:
# REDIS_URL=redis://127.0.0.1:6379

# ===== База данных (PostgreSQL) =====
# Приложение на той же VM — подключение по localhost.
DATABASE_URL=postgres://energyteam:ПАРОЛЬ@localhost:5432/energyteam

# ===== Сессии / авторизация =====
AUTH_SESSION_SECRET=
AUTH_USERS_JSON=

# ===== Bitrix24 =====
BITRIX_ALLOWED_DOMAIN=
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BIZPROC_HANDLER_SECRET=

# ===== Reg.ru (ISPmanager) =====
USER_REG=
PASSWD_REG=

# ===== Яндекс 360 =====
YANDEX_TOKEN=
YANDEX_ORG_ID=

# ===== Cloud Contact (BrightPattern) =====
# client_id общий для всех вкладок; секрет свой у каждой.
CLOUD_CONTACT_CLIENT_ID=
CLOUD_CONTACT_CLIENT_SECRET=
CLOUD_CONTACT_MSP_CLIENT_SECRET=
CLOUD_CONTACT_BACK_CLIENT_SECRET=
