# ===== Параметры сервера =====
PORT=3000
# Папка со собранным фронтендом (по умолчанию ./frontend/dist)
# ASSETS_DIR=/var/www/service-acc/frontend/dist
# Публичный адрес за туннелем (serveo/ngrok/cloudflared). Укажите СВОЙ URL —
# тогда HTTPS/CSRF/Secure-cookie будут считаться по нему, а не по заголовкам.
# PUBLIC_ORIGIN=https://energyb24.serveo.net

# ===== Хранилище (замена Cloudflare KV) =====
# По умолчанию — файловое хранилище, Redis НЕ нужен (подходит для
# виртуального хостинга). Папка данных (по умолчанию ./.data):
# DATA_DIR=./.data
#
# Redis используйте только если он есть (например, на VPS) — тогда
# раскомментируйте строку ниже, и приложение возьмёт Redis вместо файлов:
# REDIS_URL=redis://127.0.0.1:6379

# ===== База данных (PostgreSQL) =====
# Приложение на той же VM — подключение по localhost.
DATABASE_URL=postgres://energyteam:ПАРОЛЬ@localhost:5432/energyteam

# ===== Реестр участников (вкладка «Все Пользователи») =====
# Ключ шифрования паролей в БД (AES-256-GCM). 32 байта.
# Сгенерировать:  openssl rand -hex 32
ENCRYPTION_KEY=
# Логины (из AUTH_USERS_JSON), которым видна вкладка и расшифрованные пароли.
# Через запятую. Пусто = не видит никто.
MEMBERS_ALLOWED_USERS=admin

# ===== Сессии / авторизация =====
AUTH_SESSION_SECRET=
AUTH_USERS_JSON=

# ===== Bitrix24 =====
BITRIX_ALLOWED_DOMAIN=
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BIZPROC_HANDLER_SECRET=

# ===== Reg.ru (ISPmanager) =====
USER_REG=
PASSWD_REG=

# ===== Яндекс 360 =====
YANDEX_TOKEN=
YANDEX_ORG_ID=

# ===== VPN (NetBird) =====
# Токен API NetBird (Settings → API keys). Остаётся на сервере, в браузер
# не попадает. Без лишних пробелов и БЕЗ точки с запятой в конце.
VPN_TOKEN=
# Необязательно: адрес NetBird, если отличается от дефолтного.
# VPN_API_BASE=https://vpn.energy-team.ru
# Необязательно: адрес дашборда для ссылок-приглашений в письмах.
# Если не задан, используется VPN_API_BASE.
# VPN_INVITE_BASE_URL=https://vpn.energy-team.ru

# ===== Cloud Contact (BrightPattern) =====
# client_id общий для всех вкладок; секрет свой у каждой.
CLOUD_CONTACT_CLIENT_ID=
CLOUD_CONTACT_CLIENT_SECRET=
CLOUD_CONTACT_MSP_CLIENT_SECRET=
CLOUD_CONTACT_BACK_CLIENT_SECRET=

# ===== Отправка почты (SMTP) =====
# Служебный ящик для писем из приложения (логины, пароли, уведомления).
# НИКОГДА не отдаём эти значения в браузер — только серверный nodemailer.
# Пароль — именно пароль почтового ящика, а НЕ USER_REG/PASSWD_REG панели.
MAIL_HOST=mail.hosting.reg.ru
# 465 — TLS сразу (secure=1). Альтернатива: 587 с STARTTLS, 25 (обычно блокируют).
MAIL_PORT=465
# 1 = SSL/TLS сразу (для 465). 0 = plain + STARTTLS (для 587).
MAIL_SECURE=1
MAIL_USER=noreply@energy-team.club
MAIL_PASS=
# Что показывать получателю в поле «От» (можно с именем).
MAIL_FROM=Сервис УЗ <noreply@energy-team.club>
# Куда разрешено отправлять: только свои домены (защита от открытого релея).
# Через запятую, без пробелов. Пусто = без ограничений (не рекомендуется).
MAIL_ALLOWED_DOMAINS=energy-team.club,energy-team.ru
# Проверка TLS-сертификата. 0 — только для отладки, в проде оставить 1.
MAIL_REQUIRE_TLS=1
